# Public browser configuration. The anon key is not an administrative secret.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# FFTT credentials must be set ONLY in Vercel/Supabase server environments.
# Never prefix these server secrets with VITE_.
# FFTT_APP_ID
# FFTT_APP_PASSWORD
# FFTT_SERIAL
# FFTT_CLUB_NUMBER
